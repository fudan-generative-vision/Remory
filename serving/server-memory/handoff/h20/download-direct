#!/bin/sh
set -eu
if [ "$#" -eq 0 ]; then
    printf '%s\n' 'Usage: download-direct COMMAND [ARG ...]' >&2
    exit 2
fi
exec env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY \
    -u http_proxy -u https_proxy -u all_proxy \
    HF_ENDPOINT=https://hf-mirror.com HF_HUB_DISABLE_IMPLICIT_TOKEN=1 \
    NO_PROXY='*' no_proxy='*' "$@"
